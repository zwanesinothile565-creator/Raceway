@model List<Raceway.ViewModels.ManageUserRolesViewModel>

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container mt-4">

    <h2>
        Manage Role for:
        <strong>@ViewBag.UserName</strong>
    </h2>

    <hr />

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <div class="card-header">
                <h5>Add / Remove Roles</h5>
            </div>

            <div class="card-body">

                @if (Model != null && Model.Count > 0)
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="form-check mt-1">

                            <input type="hidden"
                                   asp-for="@Model[i].RoleId" />

                            <input type="hidden"
                                   asp-for="@Model[i].RoleName" />

                            <input type="checkbox"
                                   asp-for="@Model[i].IsSelected"
                                   class="form-check-input" />

                            <label class="form-check-label"
                                   asp-for="@Model[i].IsSelected">
                                @Model[i].RoleName
                            </label>

                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">
                        No roles are available.
                    </p>
                }

            </div>

            <div class="card-footer">

                <button type="submit"
                        class="btn btn-primary">
                    Update Roles
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>
        </div>

    </form>

</div>